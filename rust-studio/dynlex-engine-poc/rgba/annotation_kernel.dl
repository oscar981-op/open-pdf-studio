import renderer.dl

# OPAN-v1 is an internal, Rust-validated list of native annotation marks.
# Header: magic, version, width, height, count (five little-endian u32).
# Each 24-byte mark has kind, x0, y0, x1, y1, RGB and opacity.
# Kinds 3 and 4 receive premultiplied Highlight channels. Rust partitions
# partial Vello tiles (kind 3, masked blend) from full tiles (kind 4, direct
# source-over) before invoking the kernel. The commands never overlap.
# Version 1 paints onto opaque RGBA. Version 2 paints onto a validated
# premultiplied PDF-content layer and updates alpha in drawing order.
# Version 3 appends three 256-byte linear-light selection-blend tables;
# kind 5 paints the 75%-covered 1.5px selection border on an opaque page.
# It trusts the Rust boundary for all bounds.
function render {cstring:scene} into {cstring:pixels}:
    execute:
        set version to unsigned word at 4 in scene
        set width to unsigned word at 8 in scene
        set count to unsigned word at 16 in scene
        set index to 0
        loop while index < count:
            set offset to 20 + index * 24
            set kind to unsigned word at offset in scene
            set left to unsigned word at (offset + 4) in scene
            set top to unsigned word at (offset + 8) in scene
            set right to unsigned word at (offset + 12) in scene
            set bottom to unsigned word at (offset + 16) in scene
            set red to unsigned byte at (offset + 20) in scene
            set green to unsigned byte at (offset + 21) in scene
            set blue to unsigned byte at (offset + 22) in scene
            set opacity to unsigned byte at (offset + 23) in scene
            set y to top
            loop while y < bottom:
                set x to left
                loop while x < right:
                    set hit to 0
                    if kind = 1:
                        set hit to 1
                    if kind = 3:
                        set hit to 1
                    if kind = 4:
                        set hit to 1
                    if kind = 2 or kind = 5:
                        if x < (left + 2):
                            set hit to 1
                        if (x + 2) >= right:
                            set hit to 1
                        if y < (top + 2):
                            set hit to 1
                        if (y + 2) >= bottom:
                            set hit to 1
                    if hit = 1:
                        set pixel to (y * width + x) * 4
                        if kind = 5:
                            set lut to 20 + count * 24
                            set old_red to unsigned byte at pixel in pixels
                            set old_green to unsigned byte at (pixel + 1) in pixels
                            set old_blue to unsigned byte at (pixel + 2) in pixels
                            store (unsigned byte at (lut + old_red) in scene) into pixels at pixel
                            store (unsigned byte at (lut + 256 + old_green) in scene) into pixels at (pixel + 1)
                            store (unsigned byte at (lut + 512 + old_blue) in scene) into pixels at (pixel + 2)
                        else if opacity = 255:
                            store (red as a byte) into pixels at pixel
                            store (green as a byte) into pixels at (pixel + 1)
                            store (blue as a byte) into pixels at (pixel + 2)
                            if version = 2:
                                store (255 as a byte) into pixels at (pixel + 3)
                        else if kind = 3:
                            set old_red to unsigned byte at pixel in pixels
                            set old_green to unsigned byte at (pixel + 1) in pixels
                            set old_blue to unsigned byte at (pixel + 2) in pixels
                            store (((red * 255 + old_red * (255 - opacity) + 255) / 256) as a byte) into pixels at pixel
                            store (((green * 255 + old_green * (255 - opacity) + 255) / 256) as a byte) into pixels at (pixel + 1)
                            store (((blue * 255 + old_blue * (255 - opacity) + 255) / 256) as a byte) into pixels at (pixel + 2)
                            if version = 2:
                                set old_alpha to unsigned byte at (pixel + 3) in pixels
                                store (((opacity * 255 + old_alpha * (255 - opacity) + 255) / 256) as a byte) into pixels at (pixel + 3)
                        else if kind = 4:
                            set old_red to unsigned byte at pixel in pixels
                            set old_green to unsigned byte at (pixel + 1) in pixels
                            set old_blue to unsigned byte at (pixel + 2) in pixels
                            store ((red + (old_red * (255 - opacity) + 255) / 256) as a byte) into pixels at pixel
                            store ((green + (old_green * (255 - opacity) + 255) / 256) as a byte) into pixels at (pixel + 1)
                            store ((blue + (old_blue * (255 - opacity) + 255) / 256) as a byte) into pixels at (pixel + 2)
                            if version = 2:
                                set old_alpha to unsigned byte at (pixel + 3) in pixels
                                store ((opacity + (old_alpha * (255 - opacity) + 255) / 256) as a byte) into pixels at (pixel + 3)
                        else:
                            set old_red to unsigned byte at pixel in pixels
                            set old_green to unsigned byte at (pixel + 1) in pixels
                            set old_blue to unsigned byte at (pixel + 2) in pixels
                            store ((blend old_red with red at opacity) as a byte) into pixels at pixel
                            store ((blend old_green with green at opacity) as a byte) into pixels at (pixel + 1)
                            store ((blend old_blue with blue at opacity) as a byte) into pixels at (pixel + 2)
                    set x to x + 1
                set y to y + 1
            set index to index + 1
        return 0

set dummy_scene to allocate 20 bytes
set dummy_pixels to allocate 4 bytes
set status to render dummy_scene into dummy_pixels
print status as a line
