import renderer.dl

# Trusted POC buffer entry point. The Rust caller must validate the complete
# OPDL-v2 scene and reserve 12 control bytes before the RGBA output.
function render {cstring:scene} into {cstring:rgba}:
    execute:
        set mode to unsigned word at 0 in rgba
        set size to unsigned word at 4 in rgba
        set capacity to unsigned word at 8 in rgba
        set pixels to rgba + 12
        set version to unsigned word at 4 in scene
        set width to unsigned word at 8 in scene
        set height to unsigned word at 12 in scene
        set clip_left to unsigned word at 16 in scene
        set clip_top to unsigned word at 20 in scene
        set clip_right to unsigned word at 24 in scene
        set clip_bottom to unsigned word at 28 in scene
        set image_length to unsigned word at 32 in scene
        set count_offset to 36 + image_length
        set command_count to unsigned word at count_offset in scene
        set command_start to count_offset + 4
        if mode = 2:
            discard @intrinsic("call", "libc", "memset", a pointer to a byte, pixels, 255, width * height * 4)
        else:
            set y to 0
            loop while y < height:
                set x to 0
                loop while x < width:
                    set red to 255
                    set green to 255
                    set blue to 255
                    if x >= clip_left and x < clip_right and y >= clip_top and y < clip_bottom:
                        if image_length != 0:
                            set image_index to 36 + ((y * width + x) * 3)
                            set red to unsigned byte at image_index in scene
                            set green to unsigned byte at (image_index + 1) in scene
                            set blue to unsigned byte at (image_index + 2) in scene
                    set pixel_index to (y * width + x) * 4
                    store (red as a byte) into pixels at pixel_index
                    store (green as a byte) into pixels at (pixel_index + 1)
                    store (blue as a byte) into pixels at (pixel_index + 2)
                    store (255 as a byte) into pixels at (pixel_index + 3)
                    set x to x + 1
                set y to y + 1
        if mode != 1:
            set command to 0
            loop while command < command_count:
                set offset to command_start + command * 24
                set kind to unsigned word at offset in scene
                set left to unsigned word at (offset + 4) in scene
                set top to unsigned word at (offset + 8) in scene
                set right to unsigned word at (offset + 12) in scene
                set bottom to unsigned word at (offset + 16) in scene
                set ink_red to unsigned byte at (offset + 20) in scene
                set ink_green to unsigned byte at (offset + 21) in scene
                set ink_blue to unsigned byte at (offset + 22) in scene
                set opacity to unsigned byte at (offset + 23) in scene
                set draw_y to top
                if draw_y < clip_top:
                    set draw_y to clip_top
                set stop_y to bottom
                if stop_y > clip_bottom:
                    set stop_y to clip_bottom
                set stop_x to right
                if stop_x > clip_right:
                    set stop_x to clip_right
                loop while draw_y < stop_y:
                    set draw_x to left
                    if draw_x < clip_left:
                        set draw_x to clip_left
                    loop while draw_x < stop_x:
                        set hit to 0
                        set effective_opacity to opacity
                        if kind = 1 or kind = 3:
                            set hit to 1
                        if kind = 2:
                            set line_x to left + (draw_y - top)
                            if draw_x = line_x or draw_x + 1 = line_x or draw_x = line_x + 1:
                                set hit to 1
                        if kind = 4:
                            set line_x to left + (draw_y - top)
                            set coverage to 0
                            if draw_y = top or draw_y + 1 = bottom:
                                if draw_x = line_x:
                                    set coverage to 117
                                if draw_y = top and draw_x = line_x + 1:
                                    set coverage to 64
                                if draw_y + 1 = bottom and draw_x + 1 = line_x:
                                    set coverage to 64
                            else:
                                if draw_x = line_x:
                                    set coverage to 233
                                if draw_x + 1 = line_x or draw_x = line_x + 1:
                                    set coverage to 64
                            if coverage > 0:
                                set hit to 1
                                set effective_opacity to (opacity * coverage + 127) / 255
                        if hit = 1:
                            set pixel_index to (draw_y * width + draw_x) * 4
                            if effective_opacity = 255:
                                store (ink_red as a byte) into pixels at pixel_index
                                store (ink_green as a byte) into pixels at (pixel_index + 1)
                                store (ink_blue as a byte) into pixels at (pixel_index + 2)
                            else:
                                set old_red to unsigned byte at pixel_index in pixels
                                set old_green to unsigned byte at (pixel_index + 1) in pixels
                                set old_blue to unsigned byte at (pixel_index + 2) in pixels
                                store ((blend old_red with ink_red at effective_opacity) as a byte) into pixels at pixel_index
                                store ((blend old_green with ink_green at effective_opacity) as a byte) into pixels at (pixel_index + 1)
                                store ((blend old_blue with ink_blue at effective_opacity) as a byte) into pixels at (pixel_index + 2)
                        set draw_x to draw_x + 1
                    set draw_y to draw_y + 1
                set command to command + 1
        return 0

# The compiler needs a typed call to materialize the function in LLVM IR.
# The generated main is removed when the object is linked as a library.
set dummy_scene to allocate 40 bytes
set dummy_rgba to allocate 12 bytes
set status to render dummy_scene into dummy_rgba
print status as a line
